{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 bun scripts/dev.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "eval:agent": "bun --preload ./scripts/agent-eval/preload.ts ./scripts/agent-eval/run.ts",
    "eval:live:setup": "EVAL_LIVE=1 bun --preload ./scripts/agent-eval/preload.ts ./scripts/agent-eval/sales.ts setup",
    "eval:live:cleanup": "EVAL_LIVE=1 bun --preload ./scripts/agent-eval/preload.ts ./scripts/agent-eval/sales.ts cleanup",
    "eval:live": "EVAL_LIVE=1 bun --preload ./scripts/agent-eval/preload.ts ./scripts/agent-eval/run.ts",
    "audit": "bun scripts/security/audit.ts",
    "audit:fix": "bun scripts/security/audit-fix.ts",
    "update:libs": "bun scripts/security/update.ts",
    "preview": "vite preview --port 3300",
    "token": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 bun scripts/token-server.ts",
    "token:login": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 bun scripts/token-server.ts login",
    "export:html": "vite build --mode html && bun scripts/export-html.ts",
    "export:server": "bun build --compile scripts/token-server.ts --outfile dist/hub-token-server"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@codemirror/lang-json": "^6.0.2",
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "powerbi-client": "^2.25.0",
    "powerbi-report-authoring": "^3.0.0",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.13",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "4.1.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "1.168.48",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  },
  "overrides": {
    "image-size": "^2.0.3",
    "powerbi-client": "2.25.0",
    "zod": "^4.6.6"
  }
}
