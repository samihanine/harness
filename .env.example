# Hub — copy to .env (next to the server or the executable). Empty values are ignored. A value set here is the
# default of its setting: a change made in Settings wins over it, and "Reset" in Settings comes back to it.

# --- AI (Settings › AI) -------------------------------------------------------------------------------
# anthropic | maia | claude-code
HUB_AI_PROVIDER=
HUB_AI_MODEL=
# low | medium | high
HUB_AI_EFFORT=
HUB_AI_MAX_STEPS=
# Anthropic API key (tests)
ANTHROPIC_API_KEY=
# Maia (TrustLayer v2)
MAIA_URL=https://genapi.lvmh.com
MAIA_CLIENT_ID=
MAIA_CLIENT_SECRET=
MAIA_MAISON=GRP
MAIA_USE_CASE=hub
MAIA_ENVIRONMENT=PRD
# Claude Code through a gateway (Claude Maison): its address, headers, and the script giving the token
ANTHROPIC_BASE_URL=
ANTHROPIC_CUSTOM_HEADERS=
OKTA_SCRIPT=

# --- Power BI limits (Settings › Power BI) ------------------------------------------------------------
HUB_DAX_MAX_ROWS=
HUB_DAX_TIMEOUT_MS=
HUB_DAX_CONCURRENCY=
HUB_DAX_CACHE_MS=

# --- Confluence (Settings › Confluence) ----------------------------------------------------------------
CONFLUENCE_API_URL=https://<site>.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_KEY=
# Projects: one sub-folder per project (its name), their pages given to the assistants (id or link).
CONFLUENCE_PROJECTS_FOLDER_ID=
# The team's catalog: one page per report / semantic model (title = name; content = Power BI link + description).
CONFLUENCE_REPORT_FOLDER_ID=
CONFLUENCE_DATASET_FOLDER_ID=
# true: the catalog can be changed from Settings (Reports / Models tabs); the Confluence key must be able to write.
CONFLUENCE_CATALOG_EDIT=false

# --- Look (Settings › General) --------------------------------------------------------------------------
HUB_PRIMARY_COLOR="#b39251"

# --- Server ---------------------------------------------------------------------------------------------
# PORT=3300
# HOST=127.0.0.1
# HUB_ALLOWED_HOSTS=hub.example.com
# HUB_DATA_DIR=.local
