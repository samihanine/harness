{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "paths": { "@/*": ["./src/*"], "@server/*": ["./server/*"], "@shared/*": ["./shared/*"] }
  },
  "include": ["src", "server", "shared", "scripts", "vite.config.ts"]
}
